---
const { sideBarActiveItemID } = Astro.props;
const activeClass = "bg-slate-950 text-white shadow-md shadow-slate-200";
const baseUrl = import.meta.env.BASE_URL;
---

<ul class="menu grow shrink menu-md gap-1 overflow-y-auto">
    <li><a class="rounded-2xl py-3 text-base font-semibold text-slate-700 hover:bg-amber-100" id="home" href={baseUrl}>Home</a></li>
    <li><a class="rounded-2xl py-3 text-base font-semibold text-slate-700 hover:bg-amber-100" id="projects" href={`${baseUrl}#education`}>Education</a></li>
    <li><a class="rounded-2xl py-3 text-base font-semibold text-slate-700 hover:bg-amber-100" id="services" href={`${baseUrl}#experience`}>Experience</a></li>
    <li><a class="rounded-2xl py-3 text-base font-semibold text-slate-700 hover:bg-amber-100" id="store" href={`${baseUrl}#skills`}>Skills</a></li>
    <li><a class="rounded-2xl py-3 text-base font-semibold text-slate-700 hover:bg-amber-100" id="contact-link" href={`${baseUrl}#contact`}>Contact</a></li>
</ul>

<script define:vars={{ sideBarActiveItemID: sideBarActiveItemID, activeClass: activeClass }}>
const activeItemElem = document.getElementById(sideBarActiveItemID);
activeItemElem && activeItemElem.classList.add(activeClass);
</script>
