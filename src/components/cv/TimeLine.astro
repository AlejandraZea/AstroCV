---
const { title, subtitle } = Astro.props;
---

<div class="flex">
  <div class="education__time pt-2">
    <span class="block h-4 w-4 rounded-full border-4 border-white bg-amber-500 shadow-md shadow-amber-200"></span>
    <span class="education__line block h-full w-[2px] translate-x-[7px] bg-slate-200"></span>
  </div>
  <div class="experience__data bd-grid ml-4 flex-1 rounded-2xl border border-slate-200 bg-white p-5 shadow-sm transition hover:-translate-y-0.5 hover:shadow-lg hover:shadow-slate-200/80">
    <h3 class="mb-1 text-lg font-black text-slate-950">{title}</h3>
    {subtitle && <span class="text-sm font-semibold text-amber-700">{subtitle}</span>}
    <p class="mt-3 leading-7 text-slate-600">
      <slot />
    </p>
  </div>
</div>
