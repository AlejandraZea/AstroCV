---
import TimeLineElement from "../components/cv/TimeLine.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import heroImage from "../../public/isometric.jpg";

const highlights = [
  { value: "2+", label: "years in software QA" },
  { value: "CI/CD", label: "deployment validation" },
  { value: "12+", label: "tools and technologies" },
];

const focusAreas = [
  "Regression testing",
  "Release candidates",
  "Azure DevOps",
  "Playwright automation",
];

const skills = [
  { name: "Manual QA", type: "Testing" },
  { name: "Regression Testing", type: "Testing" },
  { name: "API Testing", type: "Testing" },
  { name: "Playwright", type: "Automation" },
  { name: "Azure DevOps", type: "Workflow" },
  { name: "CI/CD Pipelines", type: "Workflow" },
  { name: "Scrum", type: "Agile" },
  { name: "Kanban", type: "Agile" },
  { name: "Git", type: "Workflow" },
  { name: "MySQL", type: "Data" },
  { name: "Java", type: "Code" },
  { name: "JavaScript", type: "Code" },
  { name: "HTML", type: "Frontend" },
  { name: "CSS", type: "Frontend" },
  { name: "Tailwind", type: "Frontend" },
  { name: "Laravel", type: "Framework" },
  { name: "WordPress", type: "CMS" },
];
---

<BaseLayout sideBarActiveItemID="home">
  <section
    class="hero-panel relative overflow-hidden rounded-[2rem] border border-slate-200/80 bg-white shadow-xl shadow-slate-200/60"
  >
    <div
      class="absolute inset-x-0 top-0 h-2 bg-gradient-to-r from-yellow-400 to-rose-400"
    >
    </div>

    <div
      class="grid min-w-0 gap-8 p-6 sm:p-8 lg:grid-cols-[1.15fr_0.85fr] lg:p-10"
    >
      <div class="flex min-w-0 flex-col justify-center">
        <p
          class="mb-4 inline-flex w-fit max-w-full items-center rounded-full border border-rose-200 px-3 py-1 text-sm font-semibold leading-6 text-amber-700"
        >
          QA Engineer - Chihuahua, Mexico
        </p>
        <h1
          class="max-w-3xl break-words text-[2.35rem] font-black leading-[1.08] tracking-normal text-slate-950 sm:text-5xl"
        >
          Karla Alejandra De la Cruz Zea
        </h1>
        <p class="mt-4 max-w-2xl text-lg leading-8 text-slate-600 text-justify">
          QA Engineer with 2+ years of experience ensuring software quality
          through manual and regression testing in production environments. I
          have hands-on experience working with Agile methodologies (Scrum &
          Kanban), managing release candidates, and validating deployments using
          CI/CD pipelines in Azure DevOps. Currently, I am expanding my skills
          in test automation using Playwright, building scalable automated
          testing solutions. I am passionate about improving software quality,
          preventing regressions, and continuously learning new tools and
          technologies.
        </p>

        <div class="mt-7 flex min-w-0 flex-wrap gap-3">
          <a
            class="btn min-h-0 rounded-full border-0 bg-amber-800 px-5 text-white hover:bg-amber-600"
            href="mailto:alejandra.d.zea@gmail.com"
          >
            Contact me
          </a>
          <a
            class="btn btn-outline min-h-0 rounded-full border-amber-300 px-5 text-slate-800 hover:border-amber-300 hover:bg-amber-500 hover:text-white"
            href="https://www.linkedin.com/in/alejandra-de-la-cruz-zea-33751166/"
            target="_blank"
          >
            LinkedIn
          </a>
          <a
            class="btn btn-ghost min-h-0 rounded-full px-5 text-slate-700 hover:bg-amber-200"
            href="https://github.com/AlejandraZea"
            target="_blank"
          >
            GitHub
          </a>
        </div>

        <div class="mt-8 grid gap-3 sm:grid-cols-3">
          {
            highlights.map((item) => (
              <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <div class="text-3xl font-black text-slate-950">
                  {item.value}
                </div>
                <div class="mt-1 text-sm font-medium leading-5 text-slate-500">
                  {item.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>

      <div
        class="relative min-h-[420px] min-w-0 overflow-hidden rounded-[1.5rem] bg-slate-950 text-white"
      >
        <img
          src={heroImage.src}
          alt="Sunlit fantasy ruins surrounded by flowers"
          class="absolute inset-0 h-full w-full object-cover object-center opacity-90"
        />
        <div
          class="absolute inset-0 bg-gradient-to-t from-slate-950 via-slate-950/35 to-slate-950/5"
        >
        </div>
        <div
          class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(255,255,255,0.34),transparent_16rem)]"
        >
        </div>
        <div class="absolute bottom-0 left-0 right-0 p-6">
          <div
            class="mb-4 rounded-2xl border border-white/15 bg-white/10 p-4 shadow-2xl backdrop-blur"
          >
            <p
              class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-300 text-center"
            >
              Current focus
            </p>
            <div class="mt-3 grid grid-cols-2 gap-2">
              {
                focusAreas.map((area) => (
                  <span class="rounded-full bg-white/12 px-3 py-2 text-sm font-medium text-white">
                    {area}
                  </span>
                ))
              }
            </div>
          </div>
          <p class="text-sm leading-6 text-slate-200 text-justify">
            Focused on release confidence, regression prevention, and automation
            practices that help teams move faster.
          </p>
        </div>
      </div>
    </div>
  </section>

  <section class="section-block" id="education">
    <div class="section-heading">
      <p>
        Academic path
      </p>
      <h2>Education</h2>
    </div>

    <div class="time-line-container grid gap-5">
      <TimeLineElement
        title="Software Development and Project Management Engineering Graduate"
      >
        <span class="text-sm font-semibold text-slate-500">
          2024 to 2026 - Universidad Tecnologica de Chihuahua, Chihuahua,
          Mexico. Degree process scheduled for September 2026.
        </span>
      </TimeLineElement>
      <TimeLineElement
        title="TSU Information Technology - Multiplatform Software Development"
      >
        <span class="text-sm font-semibold text-slate-500">
          2021 to 2024 - Universidad Tecnologica de Chihuahua, Chihuahua, Mexico
        </span>
      </TimeLineElement>
    </div>
  </section>

  <section class="section-block" id="experience">
    <div class="section-heading">
      <p>Professional story</p>
      <h2>Experience</h2>
    </div>

    <div class="time-line-container grid gap-5">
      <TimeLineElement
        title="QA Engineer"
        subtitle="1A Auto - August 2023 to Present"
      >
        Manual and regression testing in production environments, defect
        reporting and tracking, release candidate management, deployment
        validation through CI/CD pipelines, and automated test results analysis.
        Tech stack: Azure DevOps, JUnit, Java, JavaScript, and Playwright.
      </TimeLineElement>
      <TimeLineElement
        title="QA Manual Tester"
        subtitle="Intelectix - June 2023 to August 2023"
      >
        Manual testing and API testing. Tech stack: MySQL, C#, and .NET.
      </TimeLineElement>
      <TimeLineElement
        title="Web Designer"
        subtitle="Anchondo Sistemas - October 2018 to September 2021"
      >
        Web design and manual testing for production websites. Tech stack:
        MySQL, Laravel, WordPress.
      </TimeLineElement>
    </div>
  </section>

  <section class="section-block" id="skills">
    <div class="section-heading">
      <p>Practical toolkit</p>
      <h2>Skills</h2>
    </div>

    <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        skills.map((skill) => (
          <div class="skill-card">
            <span>{skill.type}</span>
            <strong>{skill.name}</strong>
          </div>
        ))
      }
    </div>
  </section>

  <section class="section-block" id="contact">
    <div class="section-heading">
      <p>Let's talk</p>
      <h2>Contact</h2>
    </div>

    <div
      class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-xl shadow-slate-200/60"
    >
      <div class="grid gap-0 lg:grid-cols-[0.9fr_1.1fr]">
        <div class="bg-slate-950 p-6 text-white sm:p-8">
          <p
            class="text-sm font-semibold uppercase tracking-[0.18em] text-amber-300"
          >
            Available for QA roles
          </p>
          <h3 class="mt-4 text-3xl font-black leading-tight">
            Focused on high-quality software through effective testing. 
          </h3>
          <p class="mt-4 leading-7 text-slate-300">
            Reach out via email or explore my work on LinkedIn and GitHub.
          </p>
          <a
            class="btn mt-6 min-h-0 rounded-full border-0 bg-white px-5 text-slate-950 hover:bg-amber-100"
            href="mailto:alejandra.d.zea@gmail.com"
          >
            Email me
          </a>
        </div>

        <div class="grid gap-3 p-6 sm:p-8">
          <a class="contact-row" href="mailto:alejandra.d.zea@gmail.com">
            <span>Email</span>
            <strong>alejandra.d.zea@gmail.com</strong>
          </a>
          <a
            class="contact-row"
            href="https://www.linkedin.com/in/alejandra-de-la-cruz-zea-33751166/"
            target="_blank"
          >
            <span>LinkedIn</span>
            <strong>alejandra-de-la-cruz-zea</strong>
          </a>
          <a
            class="contact-row"
            href="https://github.com/AlejandraZea"
            target="_blank"
          >
            <span>GitHub</span>
            <strong>AlejandraZea</strong>
          </a>
          <div class="contact-row">
            <span>Location</span>
            <strong>Chihuahua, Mexico</strong>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
